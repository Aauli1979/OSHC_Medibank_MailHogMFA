# Compose reads .env next to compose.yaml. Copy this file to .env.
APP_BIND=127.0.0.1
APP_PORT=8088
FRONTEND_URL=http://localhost:8088
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=OSHC SmartGuide
WEBAUTHN_ORIGINS=http://localhost:8088
# Set true for HTTPS; applies to authentication AND challenge-session cookies.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# Local MailHog captures email; no external SMTP account is needed.
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_FROM=oshc-smartguide@localhost
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_SMTP_STARTTLS_REQUIRED=false
MAIL_SMTP_SSL_TRUST=mailhog
MAILHOG_BIND=127.0.0.1
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
