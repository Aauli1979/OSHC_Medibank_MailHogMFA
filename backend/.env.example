# Reference for host-based development. Spring Boot does not load this file.
# Export these variables or use configure-mailhog.ps1 in your PowerShell session.
SERVER_PORT=8080
FRONTEND_URL=http://localhost:5173
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=OSHC SmartGuide
WEBAUTHN_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM=oshc-smartguide@localhost
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_SMTP_STARTTLS_REQUIRED=false
MAIL_SMTP_SSL_TRUST=127.0.0.1
