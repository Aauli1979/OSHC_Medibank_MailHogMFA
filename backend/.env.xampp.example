# OSHC SmartGuide - XAMPP/Mercury Mail configuration
# XAMPP for Windows -> Mercury Mail -> SMTP Server.
# Keep MAIL_HOST/PORT as below when Mercury listens on localhost:25.
MAIL_HOST=127.0.0.1
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_SMTP_STARTTLS_REQUIRED=false
MAIL_SMTP_SSL_TRUST=127.0.0.1
# Use a sender address accepted by your Mercury relay.
# For external delivery, configure Mercury to relay through your real SMTP provider.
MAIL_FROM=your-sender@example.com
FRONTEND_URL=http://localhost:5173
